# One-time setup for the sandbox account, run by a person with admin credentials (see README.md).
# The AWS provider and S3 backend are generated by root.hcl. This unit also talks to GitHub, so it
# declares the GitHub provider itself (token from GITHUB_TOKEN).

provider "github" {
  owner = local.github_owner
}

data "aws_caller_identity" "current" {}
data "aws_region" "current" {}

data "github_user" "owner" {
  count    = var.manage_github ? 1 : 0
  username = local.github_owner
}

data "github_repository" "this" {
  count     = var.manage_github ? 1 : 0
  full_name = var.github_repository
}

################################################################################
# Name Suffix
################################################################################
# Every name this stack gives AWS carries a random suffix: the gitea-<suffix> cluster, the
# gitea-<suffix>/db secret, the gitea-<suffix>-github-plan role, and so on. Several of those
# names stay taken after a teardown (a KMS alias stays while its key waits out the deletion
# window, secrets stay during their recovery window, cloud-nuke can leave roles or log groups
# behind), and a rebuild in the same account used to fail on them with AlreadyExists. A new
# build picks a new suffix, so it never collides with what an earlier one left.
#
# Generated once, on the first apply, and kept in this unit's state. The gitea unit reads it
# through its `dependency "state"` block. The state bucket is the one exception: Terragrunt
# needs its name before any state exists, so it stays gitea-tfstate-<account>-<region>.

resource "random_id" "suffix" {
  byte_length = 3 # 6 hex characters
}

locals {
  project = "gitea"
  name    = "${local.project}-${random_id.suffix.hex}"
  account = "sandbox"

  account_id = data.aws_caller_identity.current.account_id
  region     = data.aws_region.current.region

  github_owner             = split("/", var.github_repository)[0]
  github_repository_name   = split("/", var.github_repository)[1]
  github_oidc_host         = "token.actions.githubusercontent.com"
  github_plan_environment  = "${local.account}-plan"
  github_apply_environment = "${local.account}-apply"
  github_apply_branch      = "main"
  github_oidc_provider_arn = (var.use_existing_github_oidc_provider
    ? "arn:aws:iam::${local.account_id}:oidc-provider/${local.github_oidc_host}"
    : module.github_oidc_provider[0].arn
  )

  # GitHub Actions OIDC subject prefixes that may assume the CI roles. Repos created after
  # 2026-07-15 send the immutable form (repo:owner@<owner-id>/name@<repo-id>); older ones the
  # classic repo:owner/name. The immutable one is built from the GitHub API when manage_github is on.
  github_oidc_sub_prefixes = compact([
    "repo:${var.github_repository}",
    var.manage_github ? "repo:${local.github_owner}@${data.github_user.owner[0].id}/${local.github_repository_name}@${data.github_repository.this[0].repo_id}" : "",
  ])

  # The bucket name must match root.hcl (remote_state). The gitea unit finds the key through this
  # unit's outputs.
  state_bucket                   = "${local.project}-tfstate-${local.account_id}-${local.region}"
  state_key_alias                = "${local.name}-tofu-state"
  state_key_deletion_window_days = 30

  # Apply creates EKS and RDS, which can take longer than the default one hour session.
  plan_session_seconds  = 3600
  apply_session_seconds = 7200

  # Generated once. Bump `version` to write a new random value (the stack then picks it up on
  # its next apply). special = false: Valkey AUTH tokens reject some punctuation.
  app_secrets = {
    db      = { length = 32, version = 1, description = "Gitea PostgreSQL password" }
    valkey  = { length = 48, version = 1, description = "Gitea Valkey AUTH token" }
    admin   = { length = 24, version = 1, description = "Gitea admin user password" }
    metrics = { length = 32, version = 1, description = "Bearer token for Gitea /metrics" }
  }
  secret_recovery_window_days = 0 # sandbox: delete at once so a rebuild can reuse the names
}

################################################################################
# State Bucket
################################################################################
# Both units keep their state here (root.hcl remote_state, S3 native lockfile).
# `terragrunt apply --backend-bootstrap` creates the bucket before OpenTofu runs, so this unit's
# own state lands in it too. The import block below adopts that bucket into the
# module on the first apply; the module then sets versioning, encryption, ownership, public
# access block and the TLS-only policy (those are PUT calls, so they replace whatever
# Terragrunt configured). After the first apply the import block is a no-op.

module "state_bucket" {
  source = "../../modules/terraform-aws-s3-bucket"

  bucket = local.state_bucket

  versioning = { enabled = true }
  server_side_encryption_configuration = {
    rule = {
      apply_server_side_encryption_by_default = { sse_algorithm = "AES256" }
    }
  }

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true

  control_object_ownership = true
  object_ownership         = "BucketOwnerEnforced"

  attach_deny_insecure_transport_policy = true
}

import {
  to = module.state_bucket.aws_s3_bucket.this[0]
  id = local.state_bucket
}

################################################################################
# State Encryption Key
################################################################################
# OpenTofu encrypts the gitea unit's state and plan files with a data key from this KMS key
# (root.hcl looks it up by alias). This unit is the exception: it manages the key, so its own
# state is only S3 server-side encrypted. It holds no secret values (secrets are write-only).
# No key policy is set, so AWS applies the default one: it delegates to IAM, and role policies
# decide who can use the key. This is the only customer managed key this unit creates (Secrets
# Manager uses its AWS managed key).
#
# Plain resources instead of terraform-aws-kms: the key must carry `prevent_destroy`, and a
# lifecycle block can't be set on resources inside a module.

resource "aws_kms_key" "state" {
  description             = "OpenTofu state and plan encryption (${local.name})"
  enable_key_rotation     = true
  deletion_window_in_days = local.state_key_deletion_window_days

  lifecycle {
    prevent_destroy = true
  }
}

resource "aws_kms_alias" "state" {
  name          = "alias/${local.state_key_alias}"
  target_key_id = aws_kms_key.state.key_id
}

# Adopt a key kept from an earlier build of this account. No-op when existing_state_kms_key_id
# is null, and after the first apply. Only the key is adopted: its old alias has the old build's
# suffix, so this build adds its own alias next to it.
import {
  for_each = var.existing_state_kms_key_id == null ? toset([]) : toset([var.existing_state_kms_key_id])
  to       = aws_kms_key.state
  id       = each.value
}

################################################################################
# GitHub OIDC
################################################################################
# GitHub Actions trades its OIDC token for short-lived role credentials, so no AWS key is stored
# in GitHub. Each role trusts exactly one GitHub environment of this repository. The subject
# prefixes are built from the GitHub API (locals above): newer repos use the immutable
# `repo:owner@<id>/name@<id>` form, which a re-created repo of the same name can't match.
#
# The trust policy is written out instead of using the iam-role module's `enable_github_oidc`:
# that option checks `aud` with ForAllValues (passes when the claim is missing) and doesn't
# reference the provider resource, so the role could be created before the provider exists.

# An account has only one provider per URL. If another project already made it, set
# USE_EXISTING_GITHUB_OIDC_PROVIDER=true and the roles trust that one. We never manage or delete it.
module "github_oidc_provider" {
  source = "../../modules/terraform-aws-iam/modules/iam-oidc-provider"
  count  = var.use_existing_github_oidc_provider ? 0 : 1

  url            = "https://${local.github_oidc_host}"
  client_id_list = ["sts.amazonaws.com"]
}

# Older builds created the provider without count.
moved {
  from = module.github_oidc_provider
  to   = module.github_oidc_provider[0]
}

# Plans run on any branch (via the sandbox-plan environment), so this role is read-only plus
# what a plan needs: the state lockfile, the state key, the app secrets (opened as ephemeral
# values during plan).
module "github_plan_role" {
  source = "../../modules/terraform-aws-iam/modules/iam-role"

  name                 = "${local.name}-github-plan"
  use_name_prefix      = false
  description          = "GitHub Actions plans (${var.github_repository}, environment ${local.github_plan_environment})"
  max_session_duration = local.plan_session_seconds

  trust_policy_permissions = {
    GitHubActions = {
      actions    = ["sts:AssumeRoleWithWebIdentity"]
      principals = [{ type = "Federated", identifiers = [local.github_oidc_provider_arn] }]
      condition = [
        { test = "StringEquals", variable = "${local.github_oidc_host}:aud", values = ["sts.amazonaws.com"] },
        { test = "StringEquals", variable = "${local.github_oidc_host}:sub", values = [for p in local.github_oidc_sub_prefixes : "${p}:environment:${local.github_plan_environment}"] },
      ]
    }
  }

  policies = {
    ReadOnlyAccess = "arn:aws:iam::aws:policy/ReadOnlyAccess"
  }

  create_inline_policy = true
  inline_policy_permissions = {
    StateLockfile = {
      actions   = ["s3:PutObject", "s3:DeleteObject"]
      resources = ["${module.state_bucket.s3_bucket_arn}/*.tflock"]
    }
    StateEncryptionKey = {
      actions   = ["kms:Decrypt", "kms:GenerateDataKey"]
      resources = [aws_kms_key.state.arn]
    }
    AppSecrets = {
      actions   = ["secretsmanager:GetSecretValue"]
      resources = ["arn:aws:secretsmanager:${local.region}:${local.account_id}:secret:${local.name}/*"]
    }
  }
}

# Applies run only from main: the sandbox-apply environment has a deployment branch policy
# (GitHub Environments section below), and the trust pins the subject to that environment.
# Admin keeps the demo simple; a real deployment would scope this to the services the stack uses.
module "github_apply_role" {
  source = "../../modules/terraform-aws-iam/modules/iam-role"

  name                 = "${local.name}-github-apply"
  use_name_prefix      = false
  description          = "GitHub Actions applies (${var.github_repository}, environment ${local.github_apply_environment})"
  max_session_duration = local.apply_session_seconds

  trust_policy_permissions = {
    GitHubActions = {
      actions    = ["sts:AssumeRoleWithWebIdentity"]
      principals = [{ type = "Federated", identifiers = [local.github_oidc_provider_arn] }]
      condition = [
        { test = "StringEquals", variable = "${local.github_oidc_host}:aud", values = ["sts.amazonaws.com"] },
        { test = "StringEquals", variable = "${local.github_oidc_host}:sub", values = [for p in local.github_oidc_sub_prefixes : "${p}:environment:${local.github_apply_environment}"] },
      ]
    }
  }

  policies = {
    AdministratorAccess = "arn:aws:iam::aws:policy/AdministratorAccess"
  }
}

################################################################################
# Cluster Admin Role
################################################################################
# People reach the cluster through this role instead of their own (often SSO) identities, so
# the stack's EKS access entries never reference SSO role paths. Anyone in this account whose
# IAM policy allows sts:AssumeRole on it can use it; the gitea unit grants it cluster admin.

module "platform_eks_admin_role" {
  source = "../../modules/terraform-aws-iam/modules/iam-role"

  name            = "${local.name}-platform-eks-admin"
  use_name_prefix = false
  description     = "Cluster admin for people (the gitea unit grants its EKS access entry)"

  trust_policy_permissions = {
    AccountRoot = {
      actions    = ["sts:AssumeRole", "sts:TagSession"]
      principals = [{ type = "AWS", identifiers = ["arn:aws:iam::${local.account_id}:root"] }]
    }
  }

  create_inline_policy = true
  inline_policy_permissions = {
    EksKubeconfig = {
      actions   = ["eks:DescribeCluster", "eks:ListClusters"]
      resources = ["*"]
    }
  }
}

################################################################################
# Application Secrets
################################################################################
# Values are generated as ephemeral values and written with the write-only `secret_string_wo`
# argument, so they never appear in plan output or state. The stack reads them back
# ephemerally (RDS `password_wo`, Valkey `auth_token_wo`) and External Secrets copies them
# into the cluster. The module's own `create_random_password` uses special characters, so the
# passwords are generated here and passed in.

ephemeral "random_password" "app" {
  for_each = local.app_secrets

  length  = each.value.length
  special = false
}

module "app_secret" {
  source   = "../../modules/terraform-aws-secrets-manager"
  for_each = local.app_secrets

  name                    = "${local.name}/${each.key}"
  description             = each.value.description
  recovery_window_in_days = local.secret_recovery_window_days

  secret_string_wo         = ephemeral.random_password.app[each.key].result
  secret_string_wo_version = each.value.version
}

# Gitea's SSH host key. Every pod must present the same one, or SSH clients see "REMOTE HOST
# IDENTIFICATION HAS CHANGED" depending on which pod the NLB picks; letting each pod generate
# its own on the shared volume races on first start. Generated once here (ephemeral, write-only,
# so the private key is never in state) and mounted into every pod by External Secrets. It also
# survives cluster rebuilds, so clients' known_hosts keep working. Bump the version to rotate.
ephemeral "tls_private_key" "ssh_host" {
  algorithm = "ED25519"
}

module "ssh_host_key" {
  source = "../../modules/terraform-aws-secrets-manager"

  name                    = "${local.name}/ssh-host-key"
  description             = "Gitea SSH host key (OpenSSH private key)"
  recovery_window_in_days = local.secret_recovery_window_days

  secret_string_wo         = ephemeral.tls_private_key.ssh_host.private_key_openssh
  secret_string_wo_version = 1
}

# Gitea's own secret keys. Gitea signs cookies and tokens with these, so every pod must use the
# same ones. Left alone, each pod's init container generates its own on a fresh install (the
# chart's config_environment.sh), and the two pods can end up with different keys. Generated
# once here instead, like the SSH host key. The JWT secrets are 32 bytes in base64url (43
# characters from A-Z a-z 0-9 - _), the format `gitea generate secret` produces.
ephemeral "random_password" "app_ini_key" {
  for_each = {
    secret_key     = { length = 64, special = false }
    internal_token = { length = 64, special = false }
    jwt_secret     = { length = 43, special = true }
    lfs_jwt_secret = { length = 43, special = true }
  }

  length           = each.value.length
  special          = each.value.special
  override_special = "-_"
}

module "app_ini_keys" {
  source = "../../modules/terraform-aws-secrets-manager"

  name                    = "${local.name}/app-ini-keys"
  description             = "Gitea SECRET_KEY, INTERNAL_TOKEN, JWT_SECRET and LFS_JWT_SECRET (JSON)"
  recovery_window_in_days = local.secret_recovery_window_days

  secret_string_wo         = jsonencode({ for k, v in ephemeral.random_password.app_ini_key : k => v.result })
  secret_string_wo_version = 1
}

################################################################################
# GitHub Environments
################################################################################
# The environments the two roles trust. Plans may run from any branch; applies only from main
# (custom deployment branch policy). Each environment tells the workflow which role to assume
# through the AWS_ROLE_ARN variable, so the workflow holds no account-specific values.

resource "github_repository_environment" "plan" {
  count = var.manage_github ? 1 : 0

  repository  = local.github_repository_name
  environment = local.github_plan_environment
}

resource "github_repository_environment" "apply" {
  count = var.manage_github ? 1 : 0

  repository  = local.github_repository_name
  environment = local.github_apply_environment

  deployment_branch_policy {
    protected_branches     = false
    custom_branch_policies = true
  }
}

resource "github_repository_environment_deployment_policy" "apply_main" {
  count = var.manage_github ? 1 : 0

  repository     = local.github_repository_name
  environment    = github_repository_environment.apply[0].environment
  branch_pattern = local.github_apply_branch
}

resource "github_actions_environment_variable" "plan_role_arn" {
  count = var.manage_github ? 1 : 0

  repository    = local.github_repository_name
  environment   = github_repository_environment.plan[0].environment
  variable_name = "AWS_ROLE_ARN"
  value         = module.github_plan_role.arn
}

resource "github_actions_environment_variable" "apply_role_arn" {
  count = var.manage_github ? 1 : 0

  repository    = local.github_repository_name
  environment   = github_repository_environment.apply[0].environment
  variable_name = "AWS_ROLE_ARN"
  value         = module.github_apply_role.arn
}

# The workflow runs nothing until this exists, so a repo that hasn't been bootstrapped (a fresh
# fork, the template) never starts a deploy that can't log in.
resource "github_actions_variable" "bootstrapped" {
  count = var.manage_github ? 1 : 0

  repository    = local.github_repository_name
  variable_name = "BOOTSTRAPPED"
  value         = "true"

  depends_on = [github_actions_environment_variable.plan_role_arn, github_actions_environment_variable.apply_role_arn]
}

# Adopt variables an earlier bootstrap of this repo left behind (its state gone, for example
# after the account was wiped). GitHub answers 409 Already exists to a create, so each one that
# exists is imported instead. Environments need no import: GitHub creates them idempotently.
# An import of a variable already in state is a no-op.
data "github_repository_environments" "existing" {
  count = var.manage_github ? 1 : 0

  repository = local.github_repository_name
}

data "github_actions_variables" "existing" {
  count = var.manage_github ? 1 : 0

  name = local.github_repository_name
}

data "github_actions_environment_variables" "existing" {
  for_each = toset(var.manage_github ? [
    for e in data.github_repository_environments.existing[0].environments : e.name
    if contains([local.github_plan_environment, local.github_apply_environment], e.name)
  ] : [])

  name        = local.github_repository_name
  environment = each.key
}

locals {
  existing_github_variables = concat(
    var.manage_github ? [for v in data.github_actions_variables.existing[0].variables : v.name] : [],
    flatten([for env, d in data.github_actions_environment_variables.existing : [for v in d.variables : "${env}:${v.name}"]]),
  )
}

import {
  for_each = contains(local.existing_github_variables, "${local.github_plan_environment}:AWS_ROLE_ARN") ? toset(["AWS_ROLE_ARN"]) : toset([])
  to       = github_actions_environment_variable.plan_role_arn[0]
  id       = "${local.github_repository_name}:${local.github_plan_environment}:${each.key}"
}

import {
  for_each = contains(local.existing_github_variables, "${local.github_apply_environment}:AWS_ROLE_ARN") ? toset(["AWS_ROLE_ARN"]) : toset([])
  to       = github_actions_environment_variable.apply_role_arn[0]
  id       = "${local.github_repository_name}:${local.github_apply_environment}:${each.key}"
}

import {
  for_each = contains(local.existing_github_variables, "BOOTSTRAPPED") ? toset(["BOOTSTRAPPED"]) : toset([])
  to       = github_actions_variable.bootstrapped[0]
  id       = "${local.github_repository_name}:${each.key}"
}
