# The AWS provider (region, account guard, cost tags), backend and state encryption are
# generated by Terragrunt from root.hcl and account.hcl.

data "aws_region" "current" {}

data "aws_availability_zones" "available" {
  # Regular AZs only, no Local Zones.
  filter {
    name   = "opt-in-status"
    values = ["opt-in-not-required"]
  }
}

# IAM roles created by bootstrap/state. Looked up by name so the EKS access entries get each
# role's real ARN (path included; a path-less ARN doesn't match), and a plan fails early if the
# bootstrap hasn't run. No SSO roles: people assume platform-eks-admin.
data "aws_iam_role" "this" {
  for_each = tomap(var.role_names) # github_plan, github_apply, platform_eks_admin

  name = each.value
}

# The app secrets are created, with random values, by bootstrap/state. This stack only reads them.
data "aws_secretsmanager_secret" "this" {
  for_each = local.secret_names

  name = each.value
}

locals {
  name               = var.name # gitea-<suffix> from bootstrap/state; also the cluster name
  region             = data.aws_region.current.region
  kubernetes_version = "1.37"

  vpc_cidr           = "10.0.0.0/16"
  azs                = slice(data.aws_availability_zones.available.names, 0, 3)
  single_nat_gateway = true # sandbox: one shared NAT gateway

  # Gitea is served over HTTP at the load balancers' own hostnames (no domain or certificate).
  allowed_cidrs = ["0.0.0.0/0"] # who may reach Gitea over HTTP and SSH

  # Secrets Manager names (bootstrap/state). Their values never pass through this stack's state.
  secret_names = {
    db           = "${local.name}/db"
    valkey       = "${local.name}/valkey"
    admin        = "${local.name}/admin"
    metrics      = "${local.name}/metrics"
    ssh_host_key = "${local.name}/ssh-host-key"
    app_ini_keys = "${local.name}/app-ini-keys"
  }
  gitea_admin_username = "gitea_admin"

  # No burstable (t) classes: they run on CPU credits and slow to a crawl when the credits run
  # out, which looks like a Gitea outage. m7g.large is the smallest current Graviton m class.
  postgres_version  = "17"
  db_instance_class = "db.m7g.large"
  # Single AZ for the sandbox. Gitea upgrades never touch the database, so this doesn't affect
  # them; AWS maintenance and failures do take it offline for a few minutes. Production would
  # set true: a standby in a second AZ cuts that to ~40 s, for about double the RDS cost.
  db_multi_az            = false
  db_deletion_protection = false # also skips the final snapshot, so destroy leaves a clean account
  valkey_version         = "8.2"
  cache_node_type        = "cache.m7g.large"
  cache_replicas         = 0 # 1 = a replica in another AZ with automatic failover

  # Only the EKS cluster primary security group (Auto Mode nodes and pods) reaches these.
  data_store_ports = {
    postgres = 5432
    valkey   = 6379
    efs      = 2049
  }

  log_retention_days       = 30 # EKS control plane, Container Insights, RDS
  db_backup_retention_days = 7  # RDS point-in-time recovery window
}

################################################################################
# VPC
################################################################################
# A /16 over 3 AZs. Per AZ: public /24 (load balancers, NAT), private /20 (EKS nodes and pods;
# every pod takes a VPC IP, hence the size) and database /24 (RDS and Valkey, no internet route).

module "vpc" {
  source = "../modules/terraform-aws-vpc"

  name = local.name
  cidr = local.vpc_cidr
  azs  = local.azs

  public_subnets   = [for k, v in local.azs : cidrsubnet(local.vpc_cidr, 8, k)]
  private_subnets  = [for k, v in local.azs : cidrsubnet(local.vpc_cidr, 4, k + 1)]
  database_subnets = [for k, v in local.azs : cidrsubnet(local.vpc_cidr, 8, k + 100)]

  create_database_subnet_group       = true
  create_database_subnet_route_table = true

  enable_nat_gateway     = true
  single_nat_gateway     = local.single_nat_gateway
  one_nat_gateway_per_az = !local.single_nat_gateway

  enable_dns_hostnames = true
  enable_dns_support   = true

  # Tags the EKS Auto Mode load balancer controller uses to pick subnets.
  public_subnet_tags = {
    "kubernetes.io/role/elb" = 1
  }

  private_subnet_tags = {
    "kubernetes.io/role/internal-elb" = 1
  }

  # Strip the default security group so nothing can use it by accident.
  manage_default_security_group  = true
  default_security_group_ingress = []
  default_security_group_egress  = []

  # No VPC flow logs: they cost per GB logged and the demo doesn't need them.
}

################################################################################
# EKS
################################################################################
# EKS Auto Mode: AWS runs Karpenter, the VPC CNI, CoreDNS, kube-proxy, the EBS CSI driver, the
# load balancer controller and the Pod Identity agent, and patches the nodes.

module "eks" {
  source = "../modules/terraform-aws-eks"

  name               = local.name
  kubernetes_version = local.kubernetes_version

  # GitHub-hosted runners have no fixed IPs, so the API endpoint is public. Every call is still
  # authenticated by IAM and authorized by the access entries below.
  endpoint_public_access = true

  # Auto Mode's built-in pools: "system" for critical add-ons, "general-purpose" for everything
  # else, Gitea included.
  compute_config = {
    enabled    = true
    node_pools = ["general-purpose", "system"]
  }

  vpc_id     = module.vpc.vpc_id
  subnet_ids = module.vpc.private_subnets

  # Access entries only; no aws-auth ConfigMap. Nobody is admin just for creating the cluster
  # (with creator admin on, every plan run as github-plan would propose replacing that entry).
  authentication_mode                      = "API"
  enable_cluster_creator_admin_permissions = false

  # Workloads get AWS credentials from EKS Pod Identity, so no IRSA OIDC provider.
  enable_irsa = false

  access_entries = {
    # CI deploys (OpenTofu, Helmfile).
    github-apply = {
      principal_arn = data.aws_iam_role.this["github_apply"].arn
      policy_associations = {
        admin = {
          policy_arn   = "arn:aws:eks::aws:cluster-access-policy/AmazonEKSClusterAdminPolicy"
          access_scope = { type = "cluster" }
        }
      }
    }

    # People and break-glass: assume it from an admin session (see the kubeconfig_command output).
    platform-eks-admin = {
      principal_arn = data.aws_iam_role.this["platform_eks_admin"].arn
      policy_associations = {
        admin = {
          policy_arn   = "arn:aws:eks::aws:cluster-access-policy/AmazonEKSClusterAdminPolicy"
          access_scope = { type = "cluster" }
        }
      }
    }

    # CI plans: `helmfile diff` reads live releases, read-only.
    github-plan = {
      principal_arn = data.aws_iam_role.this["github_plan"].arn
      policy_associations = {
        view = {
          policy_arn   = "arn:aws:eks::aws:cluster-access-policy/AmazonEKSAdminViewPolicy"
          access_scope = { type = "cluster" }
        }
      }
    }
  }

  # No customer KMS key. EKS 1.28+ already envelope-encrypts all Kubernetes API data (Secrets
  # included) with an AWS-owned key by default. A module-made key would be a new key on every
  # cluster rebuild, and KMS keys can't be deleted immediately.
  create_kms_key    = false
  encryption_config = null

  # The EFS CSI driver isn't part of Auto Mode. Its Pod Identity role is in the next section.
  # (The CloudWatch add-on is a plain resource there: it has to wait for its log groups.)
  addons = {
    aws-efs-csi-driver = {
      pod_identity_association = [{
        role_arn        = module.efs_csi_pod_identity.iam_role_arn
        service_account = "efs-csi-controller-sa"
      }]
    }
  }

  # Control-plane audit trail in CloudWatch.
  enabled_log_types                      = ["api", "audit", "authenticator"]
  cloudwatch_log_group_retention_in_days = local.log_retention_days
}

################################################################################
# EKS Add-ons
################################################################################
# Add-ons Auto Mode doesn't include, with Pod Identity roles: the EFS CSI driver (mounts the
# Gitea volume) and CloudWatch Observability (Container Insights metrics and pod logs).

module "efs_csi_pod_identity" {
  source = "../modules/terraform-aws-eks-pod-identity"

  name = "${local.name}-efs-csi"

  attach_aws_efs_csi_policy = true
}

module "cloudwatch_pod_identity" {
  source = "../modules/terraform-aws-eks-pod-identity"

  name = "${local.name}-cloudwatch"

  attach_aws_cloudwatch_observability_policy = true
}

# The add-on's agents create these log groups themselves if they're missing, and then nothing
# deletes them on destroy. Creating them here first means OpenTofu owns their retention and
# removes them with the stack.
resource "aws_cloudwatch_log_group" "container_insights" {
  for_each = toset(["application", "dataplane", "host", "performance"])

  name              = "/aws/containerinsights/${local.name}/${each.key}"
  retention_in_days = local.log_retention_days
}

# A plain resource rather than the eks module's `addons`, so it can depend on the log groups
# alone (depends_on on the whole module would defer every data source in it). preserve = false
# removes the agents with the add-on, so they can't recreate a log group after it is deleted.
resource "aws_eks_addon" "cloudwatch_observability" {
  cluster_name = module.eks.cluster_name
  addon_name   = "amazon-cloudwatch-observability"
  preserve     = false

  pod_identity_association {
    role_arn        = module.cloudwatch_pod_identity.iam_role_arn
    service_account = "cloudwatch-agent"
  }

  depends_on = [aws_cloudwatch_log_group.container_insights]
}

################################################################################
# External Secrets Pod Identity
################################################################################
# External Secrets Operator (a Helmfile release) copies the six gitea/* secrets into Kubernetes
# Secrets. Its role can read exactly those. A custom policy instead of the module's
# attach_external_secrets_policy, which also allows ListSecrets on every secret and kms:Decrypt
# on every key.

module "external_secrets_pod_identity" {
  source = "../modules/terraform-aws-eks-pod-identity"

  name = "${local.name}-external-secrets"

  attach_custom_policy = true
  policy_statements = [
    {
      sid       = "ReadGiteaSecrets"
      actions   = ["secretsmanager:GetSecretValue", "secretsmanager:DescribeSecret"]
      resources = [for s in data.aws_secretsmanager_secret.this : s.arn]
    }
  ]

  associations = {
    external-secrets = {
      cluster_name    = module.eks.cluster_name
      namespace       = "external-secrets"
      service_account = "external-secrets"
    }
  }
}

################################################################################
# Security Groups
################################################################################
# One group per data store, each open on its port only to the EKS cluster primary security
# group (Auto Mode puts it on every node). Kept together here so all data store network access
# reads in one place: the RDS module has no security group, and Valkey is a plain resource.

resource "aws_security_group" "data_store" {
  for_each = local.data_store_ports

  name_prefix = "${local.name}-${each.key}-"
  description = "${each.key} from the EKS cluster only"
  vpc_id      = module.vpc.vpc_id

  tags = {
    Name = "${local.name}-${each.key}"
  }

  lifecycle {
    create_before_destroy = true
  }
}

resource "aws_vpc_security_group_ingress_rule" "data_store" {
  for_each = local.data_store_ports

  security_group_id            = aws_security_group.data_store[each.key].id
  referenced_security_group_id = module.eks.cluster_primary_security_group_id
  ip_protocol                  = "tcp"
  from_port                    = each.value
  to_port                      = each.value
  description                  = "EKS cluster primary security group"
}

################################################################################
# RDS PostgreSQL
################################################################################
# PostgreSQL: users, issues, pull requests, metadata. The password is read from Secrets Manager
# (gitea/db) as an ephemeral value and passed to the write-only `password_wo`, so it never
# lands in a plan file or state. Storage uses the AWS-managed aws/rds key.

ephemeral "aws_secretsmanager_secret_version" "db" {
  secret_id = data.aws_secretsmanager_secret.this["db"].arn
}

module "rds" {
  source = "../modules/terraform-aws-rds"

  identifier = "${local.name}-db"

  engine         = "postgres"
  engine_version = local.postgres_version
  family         = "postgres${local.postgres_version}"
  instance_class = local.db_instance_class

  db_name  = "gitea"
  username = "gitea"
  port     = 5432

  manage_master_user_password = false
  password_wo                 = ephemeral.aws_secretsmanager_secret_version.db.secret_string
  password_wo_version         = 1 # bump after rotating gitea/db to push the new value to RDS

  allocated_storage     = 20
  max_allocated_storage = 100
  storage_type          = "gp3"
  storage_encrypted     = true

  db_subnet_group_name   = module.vpc.database_subnet_group_name
  vpc_security_group_ids = [aws_security_group.data_store["postgres"].id]
  publicly_accessible    = false
  multi_az               = local.db_multi_az

  # TLS only. Already the RDS default for PostgreSQL 17; explicit so it can't drift. Gitea
  # connects with SSL_MODE=require.
  parameters = [
    {
      name         = "rds.force_ssl"
      value        = "1"
      apply_method = "pending-reboot" # what AWS stores for it; anything else is a diff every plan
    }
  ]

  backup_retention_period      = local.db_backup_retention_days
  auto_minor_version_upgrade   = true
  apply_immediately            = true
  performance_insights_enabled = true

  enabled_cloudwatch_logs_exports        = ["postgresql", "upgrade"]
  create_cloudwatch_log_group            = true
  cloudwatch_log_group_retention_in_days = local.log_retention_days

  deletion_protection = local.db_deletion_protection
  skip_final_snapshot = !local.db_deletion_protection
}

################################################################################
# ElastiCache Valkey
################################################################################
# Cache, sessions, job queues and cluster-wide locks. Losing it logs users out and drops queued
# jobs, but loses no repository data. TLS in transit, AWS-managed key at rest.
#
# Plain resources, not terraform-aws-elasticache: the module (v1.11.2) only has `auth_token`,
# which would store the token in state. `auth_token_wo` (write-only) keeps it out.

ephemeral "aws_secretsmanager_secret_version" "valkey" {
  secret_id = data.aws_secretsmanager_secret.this["valkey"].arn
}

resource "aws_elasticache_subnet_group" "valkey" {
  name       = "${local.name}-valkey"
  subnet_ids = module.vpc.database_subnets
}

resource "aws_elasticache_replication_group" "valkey" {
  replication_group_id = "${local.name}-valkey"
  description          = "Gitea cache, sessions, queues and locks"

  engine         = "valkey"
  engine_version = local.valkey_version
  node_type      = local.cache_node_type
  port           = 6379

  num_cache_clusters         = 1 + local.cache_replicas
  automatic_failover_enabled = local.cache_replicas > 0
  multi_az_enabled           = local.cache_replicas > 0

  subnet_group_name  = aws_elasticache_subnet_group.valkey.name
  security_group_ids = [aws_security_group.data_store["valkey"].id]

  at_rest_encryption_enabled = true
  transit_encryption_enabled = true
  auth_token_wo              = ephemeral.aws_secretsmanager_secret_version.valkey.secret_string
  auth_token_wo_version      = 1 # bump after rotating gitea/valkey

  apply_immediately = true
}

################################################################################
# EFS
################################################################################
# Git repositories, LFS objects and attachments, shared read-write by both Gitea pods.
# Encrypted with the AWS-managed key; the module's file system policy refuses non-TLS mounts
# (the EFS CSI driver mounts with TLS by default).

module "efs" {
  source = "../modules/terraform-aws-efs"

  name           = "${local.name}-gitea"
  creation_token = "${local.name}-gitea"

  encrypted        = true
  performance_mode = "generalPurpose"
  throughput_mode  = "elastic"

  # One mount target per private subnet, keyed by AZ: the keys are known at plan time even
  # before the subnets exist.
  create_security_group = false
  mount_targets = {
    for i, az in local.azs : az => {
      subnet_id       = module.vpc.private_subnets[i]
      security_groups = [aws_security_group.data_store["efs"].id]
    }
  }

  # Pins every file to uid/gid 1000 (the rootless Gitea user) and roots the pods at /gitea, so
  # they can't see or chown anything else on the file system.
  access_points = {
    gitea = {
      posix_user = {
        uid = 1000
        gid = 1000
      }
      root_directory = {
        path = "/gitea"
        creation_info = {
          owner_uid   = 1000
          owner_gid   = 1000
          permissions = "0750"
        }
      }
    }
  }

  # Daily AWS Backup in the default backup plan (35-day retention).
  create_backup_policy = true
  enable_backup_policy = true
}
